@{
    ViewData["Title"] = "Import file Excel";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">@ViewData["Title"]</h2>

    <div class="card p-4 shadow-sm">
        <form enctype="multipart/form-data" method="post" action="/students/import">
            <div class="form-group">
                <label for="excelFile">Chọn file Excel:</label>
                <input type="file" name="excelFile" id="excelFile" class="form-control-file" required />
            </div>
            <button type="submit" class="btn btn-primary">Tải lên</button>
        </form>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info mt-3">
            @ViewBag.Message
        </div>
    }
</div>
