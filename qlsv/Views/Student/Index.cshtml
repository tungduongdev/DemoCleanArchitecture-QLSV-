@model PaginatedResult<Domain.Entities.Student>
@using Domain.Entities;
@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<!-- Bootstrap CSS -->
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />

<style>
    /* Custom styles for Import and Export buttons */
    .excel-button {
        background-color: #28a745; /* Màu xanh lá cây */
        color: white;
        padding: 7px 7px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s;
        position: relative;
        margin-left: 5px;
    }

        .excel-button:hover {
            background-color: #218838; /* Màu xanh lá cây đậm khi hover */
        }

        .excel-button:focus {
            outline: none; /* Bỏ đường viền khi nút được nhấn */
        }

    .dropdown-menu {
        /* Thêm chút bóng cho dropdown */
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .dropdown-item {
        padding: 8px 16px; /* Padding cho các item trong dropdown */
        display: flex;
        align-items: center;
        gap: 10px; /* Khoảng cách giữa biểu tượng và chữ */
    }

        .dropdown-item .form-control-file {
            display: none; /* Ẩn input file */
        }

    /* Style cho Import button trong dropdown */
    .import-button {
        background-color: #007bff; /* Màu xanh dương cho Import */
        color: white;
        padding: 10px 15px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        width: 100%; /* Chiếm toàn bộ chiều rộng */
    }

        .import-button:hover {
            background-color: #0056b3; /* Màu xanh dương đậm khi hover */
        }

    .export-button {
        background-color: #28a745; /* Màu xanh lá cho Export */
        color: white;
        padding: 10px 15px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        width: 100%; /* Chiếm toàn bộ chiều rộng */
    }

        .export-button:hover {
            background-color: #218838; /* Màu xanh lá đậm khi hover */
        }
</style>

<!-- Table danh sách sinh viên -->
<div class="container mt-4">
    <h2 class="text-center mb-4">@ViewData["Title"]</h2>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted">Tổng số sinh viên: @Model.TotalCount</p>

        <!-- Form tìm kiếm -->
        <form class="form-inline d-flex" method="get" action="/students/search" onsubmit="return validateSearch();">
            <input type="text" name="name" class="form-control mr-2" style="width: 300px;" placeholder="Tìm kiếm theo tên" />
            <button type="submit" class="btn btn-outline-success mr-2">Tìm kiếm</button>
        </form>

        <!-- Nút thêm sinh viên và Import/Export Excel -->
        <div class="d-flex align-items-center">
            <a href="/students/create" class="btn btn-primary mr-2">
                <i class="fas fa-plus-circle"></i> Thêm sinh viên
            </a>
            <!-- Dropdown Import/Export Excel -->
            <div class="dropdown">
                <button class="excel-button" id="excelMenuButton">
                    <i class="fas fa-file-excel"></i> Excel
                </button>
                <div class="dropdown-menu" id="excelDropdown" style="display: none;">
                    <a id="exportButton" class="dropdown-item export-button" href="/students/export">
                        <i class="fas fa-file-export"></i> Xuất file Excel
                    </a>
                    <form enctype="multipart/form-data" method="post" action="/students/import" class="dropdown-item p-0">
                        <label class="import-button w-100 mb-0">
                            <i class="fas fa-file-import"></i> Import file Excel
                            <input type="file" class="form-control-file" name="excelFile" required onchange="this.form.submit();" />
                        </label>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Kiểm tra xem danh sách sinh viên có trống hay không -->
    @if (!Model.Items.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            Không có sinh viên nào trong danh sách.
        </div>
    }
    else
    {
        <table class="table table-hover table-bordered shadow-sm">
            <thead class="thead-light">
                <tr class="text-center">
                    <th>ID</th>
                    <th>Tên</th>
                    <th>Lớp</th>
                    <th>Tuổi</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model.Items)
                {
                    <tr>
                        <td class="text-center align-middle">@student.Id</td>
                        <td class="align-middle">@student.Name</td>
                        <td class="align-middle">@student.Class</td>
                        <td class="text-center align-middle">@student.Age</td>
                        <td class="text-center align-middle">
                            <a href="/students/details/@student.Id" class="btn btn-info btn-sm mx-1">
                                <i class="fas fa-info-circle"></i> Chi tiết
                            </a>
                            <a href="/students/edit/@student.Id" class="btn btn-warning btn-sm mx-1">
                                <i class="fas fa-edit"></i> Sửa
                            </a>
                            <a href="/students/delete/@student.Id" class="btn btn-danger btn-sm mx-1">
                                <i class="fas fa-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <!-- Phân trang -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link" href="/students/index?pageNumber=@(Model.PageNumber - 1)">Trước</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="/students/index?pageNumber=@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="/students/index?pageNumber=@(Model.PageNumber + 1)">Tiếp theo</a>
            </li>
        </ul>
    </nav>
    
    @if (ViewBag.SearchSuccess != null && ViewBag.SearchSuccess)
    {
        <div class="d-flex justify-content-center mt-4">
            <a href="/students/index" class="btn btn-secondary">
                <i class="fas fa-home"></i> Trở về trang chủ
            </a>
        </div>
    }
    <div id="exportMessage" class="alert alert-success" style="display: none;"></div>
    @if (TempData["ImportSuccess"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["ImportSuccess"]
        </div>
    }



</div>

<!-- JavaScript cho dropdown -->
<script>
    document.getElementById('excelMenuButton').addEventListener('click', function () {
        const dropdown = document.getElementById('excelDropdown');
        dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
    });

    window.addEventListener('click', function (event) {
        const dropdown = document.getElementById('excelDropdown');
        const button = document.getElementById('excelMenuButton');
        if (!button.contains(event.target) && !dropdown.contains(event.target)) {
            dropdown.style.display = 'none';
        }
    });
    function validateSearch() {
        const input = document.querySelector('input[name="name"]');
        if (input.value.trim() === "") {
            alert("Vui lòng nhập tên để tìm kiếm.");
            return false; // Ngăn chặn gửi biểu mẫu
        }
        return true; // Cho phép gửi biểu mẫu
    }
</script>
